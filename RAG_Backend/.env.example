RAG_GOOGLE_API_KEY=your-google-api-key
JWT_SECRET_KEY=replace-with-random-secret
RAG_LLM_PROVIDER=gemini
# SQLite is the default. Optional native PostgreSQL:
# RAG_DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/rag
# Models load on the first AI request, with CPU fallback if CUDA is unavailable.
RAG_PRELOAD_MODELS=false
